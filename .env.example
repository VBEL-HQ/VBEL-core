# Copy to .env and fill in. .env is gitignored, never commit real secrets.
# Only the anchoring adapters read the environment, and only from scripts and
# the code that constructs them; the verification path reads nothing.

# --- Solana (packages/adapter-solana) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Base58-encoded secret key of the account that pays for anchoring.
# Generate and fund a devnet one with: pnpm --filter @vbel/adapter-solana init:devnet
SOLANA_ISSUER_SECRET_KEY=

# --- Ethereum (packages/adapter-ethereum) ---
# Calldata anchoring through zero-value transactions to self.
# Defaults to sepolia; mainnet spends real ETH and must be set explicitly.
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_NETWORK=sepolia
# 0x-prefixed 64-hex private key of the paying account.
ETHEREUM_ISSUER_PRIVATE_KEY=
