{
  "name": "@vbel/adapter-ethereum",
  "version": "0.1.0",
  "description": "LedgerAdapter implementation over Ethereum calldata transactions. Execution only \u2014 config is injected, never read from process.env here.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:anchor": "tsx scripts/smoke-anchor.ts"
  },
  "dependencies": {
    "@vbel/core": "workspace:*",
    "viem": "^2.35.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VBEL-HQ/VBEL-core.git",
    "directory": "packages/adapter-ethereum"
  },
  "homepage": "https://github.com/VBEL-HQ/VBEL-core/tree/main/packages/adapter-ethereum#readme",
  "bugs": {
    "url": "https://github.com/VBEL-HQ/VBEL-core/issues"
  }
}
