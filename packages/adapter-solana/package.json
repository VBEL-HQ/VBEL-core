{
  "name": "@vbel/adapter-solana",
  "version": "0.0.1",
  "description": "LedgerAdapter implementation over the SPL Memo program, Solana devnet. Execution only — config is injected, never read from process.env here.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "init:devnet": "tsx scripts/init-devnet-issuer.ts",
    "fund:wallet": "tsx scripts/fund-devnet-wallet.ts",
    "smoke:anchor": "tsx scripts/smoke-anchor.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "@vbel/core": "workspace:*",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vbel/config": "workspace:*",
    "tsx": "^4.19.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
